{
  "schemaVersion": 1,
  "id": "${id}",
  "version": "${version}",
  "name": "${name}",
  "description": "ModsLinker is a mod that links mods together.",
  "authors": [
    "Xy_Luce"
  ],
  "contact": {
    "homepage": "https://minecraftistooeasy.github.io/",
    "sources": "https://github.com/MinecraftIsTooEasy/ModsLinker",
    "issues": "https://github.com/MinecraftIsTooEasy/ModsLinker/issues"
  },
  "license": "CC0-1.0",
  "icon": "assets/modslinker/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "org.moddedmite.modslinker.ModsLinker"
